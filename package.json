{
  "name": "easyconverter",
  "version": "2.0.0",
  "description": "An Ionic project",
  "author": "EasyConverter Team",
  "homepage": "https://github.com/yourusername/EasyConverter",
  "license": "MIT",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint",
    "format": "prettier --write \"src/**/*.{ts,html,scss,css,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,scss,css,json,md}\"",
    "e2e": "cypress open",
    "e2e:ci": "cypress run",
    "e2e:offline": "playwright test",
    "e2e:offline:ui": "playwright test --ui",
    "e2e:offline:headed": "playwright test --headed",
    "analyze": "ng build --stats-json && npx webpack-bundle-analyzer www/stats.json",
    "extract-i18n": "ng extract-i18n --output-path src/locale",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,html}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{scss,css,json,md}": [
      "prettier --write"
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^21.2.6",
    "@angular/common": "^21.2.6",
    "@angular/compiler": "^21.2.6",
    "@angular/core": "^21.2.6",
    "@angular/forms": "^21.2.6",
    "@angular/platform-browser": "^21.2.6",
    "@angular/platform-browser-dynamic": "^21.2.6",
    "@angular/router": "^21.2.6",
    "@angular/service-worker": "^21.2.6",
    "@capacitor/app": "^8.1.0",
    "@capacitor/core": "^8.3.0",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/keyboard": "^8.0.2",
    "@capacitor/network": "^8.0.1",
    "@capacitor/share": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2",
    "@ionic/angular": "^8.8.2",
    "@ionic/pwa-elements": "^3.4.0",
    "@ngx-translate/core": "^17.0.0",
    "@ngx-translate/http-loader": "^17.0.0",
    "dompurify": "^3.3.3",
    "fast-xml-parser": "^5.5.9",
    "ionicons": "^7.0.0",
    "jszip": "^3.10.1",
    "juice": "^11.1.1",
    "marked": "^16.4.1",
    "papaparse": "^5.5.3",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.5.207",
    "piexifjs": "^1.0.6",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "turndown": "^7.2.2",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "yaml": "^2.8.3",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-builders/custom-webpack": "^21.0.3",
    "@angular-devkit/build-angular": "^21.2.5",
    "@angular-eslint/builder": "^21.3.1",
    "@angular-eslint/eslint-plugin": "^21.3.1",
    "@angular-eslint/eslint-plugin-template": "^21.3.1",
    "@angular-eslint/schematics": "^21.3.1",
    "@angular-eslint/template-parser": "^21.3.1",
    "@angular/cli": "^21.2.5",
    "@angular/compiler-cli": "^21.2.6",
    "@angular/language-service": "^21.2.6",
    "@angular/localize": "^21.2.6",
    "@capacitor/cli": "^8.3.0",
    "@ionic/angular-toolkit": "^12.3.0",
    "@playwright/test": "^1.58.2",
    "@types/dompurify": "^3.2.0",
    "@types/html-minifier-terser": "^7.0.2",
    "@types/html-to-rtf": "^1.3.2",
    "@types/jasmine": "~5.1.0",
    "@types/marked": "^5.0.2",
    "@types/papaparse": "^5.5.2",
    "@types/turndown": "^5.0.6",
    "@typescript-eslint/eslint-plugin": "^8.57.2",
    "@typescript-eslint/parser": "^8.57.2",
    "cypress": "^15.13.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "^48.2.1",
    "eslint-plugin-prefer-arrow": "^1.2.3",
    "eslint-plugin-prettier": "^5.5.5",
    "husky": "^9.1.7",
    "jasmine-core": "~5.1.0",
    "jasmine-spec-reporter": "~5.0.0",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.1",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.2.0",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.3",
    "webpack-bundle-analyzer": "^4.10.2"
  }
}
