{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.ico",
          "/index.csr.html",
          "/index.html",
          "/manifest.webmanifest",
          "/*.css",
          "/*.js"
        ]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/**/*.(svg|cur|jpg|jpeg|png|apng|webp|avif|gif|otf|ttf|woff|woff2)"
        ]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "heavy-libraries",
      "urls": [
        "**/opencv.js",
        "**/tesseract.js/**",
        "**/tesseract-core.wasm.js",
        "**/worker.min.js",
        "**/tessdata/**"
      ],
      "cacheConfig": {
        "strategy": "performance",
        "maxSize": 100,
        "maxAge": "30d",
        "timeout": "10s"
      }
    },
    {
      "name": "pdf-libraries",
      "urls": [
        "**/pdf.worker.min.js",
        "**/pdfjs-dist/**"
      ],
      "cacheConfig": {
        "strategy": "performance",
        "maxSize": 50,
        "maxAge": "14d",
        "timeout": "5s"
      }
    },
    {
      "name": "api-cache",
      "urls": [],
      "cacheConfig": {
        "strategy": "freshness",
        "maxSize": 20,
        "maxAge": "1h",
        "timeout": "3s"
      }
    }
  ]
}
